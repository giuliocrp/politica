# Phase 21 probe — the most recent Camera Assemblea votazioni of the XIX
# legislature WITH the secrecy flag selected instead of filtered (compare
# tools/queries/camera_votazioni_scope.rq, which pins votazioneSegreta 0),
# so tools/probes/probe_votes_scope.py can count how many secret votes fall
# inside the candidate scope window — the "secret exclusions" column of the
# Phase 21 table. Plain SELECT, no aggregates; the probe script appends its
# own LIMIT.
PREFIX ocd: <http://dati.camera.it/ocd/>
SELECT DISTINCT ?v ?date ?segreta WHERE {
  ?v a ocd:votazione ;
     ocd:rif_leg <http://dati.camera.it/ocd/legislatura.rdf/repubblica_19> ;
     ocd:rif_assemblea ?assemblea ;
     ocd:votazioneSegreta ?segreta ;
     <http://purl.org/dc/elements/1.1/date> ?date .
}
ORDER BY DESC(?date)
